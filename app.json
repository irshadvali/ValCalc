{
  "expo": {
    "name": "Simple Vali Calculator",
    "slug": "simple-vali-calculator",
    "icon": "./assets/images/icon.png",
    "version": "1.0.4",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#003BCE"
    },
    "android": {
      "package": "com.irshadvali.valcalc",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#003BCE"
      }
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.irshadvali.valcalc"
    },
    "plugins": [
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "44921a10-18ce-4981-bb4f-94478bde777f"
      }
    }
  }
}
